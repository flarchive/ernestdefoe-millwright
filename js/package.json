{
  "private": true,
  "name": "@ernestdefoe/millwright",
  "version": "0.1.0",
  "description": "Millwright for Flarum 2",
  "devDependencies": {
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "webpack": "^5.0.0",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "check-typings": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": {
    "printWidth": 150,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
